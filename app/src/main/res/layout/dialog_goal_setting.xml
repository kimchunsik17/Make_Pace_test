<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/dark_surface"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎯 목표 설정"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="목표 거리와 페이스를 정하고 달리세요"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="20dp" />

    <!-- 목표 거리 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="목표 거리"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/btnGoal3k"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/sea_blue"
            android:text="3K"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            style="@style/Widget.MaterialComponents.Button" />

        <Button
            android:id="@+id/btnGoal5k"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:backgroundTint="#2A2A2A"
            android:text="5K"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            style="@style/Widget.MaterialComponents.Button" />

        <Button
            android:id="@+id/btnGoal10k"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:backgroundTint="#2A2A2A"
            android:text="10K"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            style="@style/Widget.MaterialComponents.Button" />

        <Button
            android:id="@+id/btnGoalHalf"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:backgroundTint="#2A2A2A"
            android:text="하프"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            style="@style/Widget.MaterialComponents.Button" />

        <Button
            android:id="@+id/btnGoalFull"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="#2A2A2A"
            android:text="풀"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

    <!-- 직접 입력 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_input_dark">

        <EditText
            android:id="@+id/etGoalDistanceCustom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="직접 입력 (예: 7.5)"
            android:inputType="numberDecimal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp" />

    </FrameLayout>

    <!-- 목표 페이스 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="목표 페이스 (분:초 /km)"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_pace_input_border">

        <EditText
            android:id="@+id/etGoalPace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:gravity="center"
            android:hint="6:00"
            android:inputType="text"
            android:imeOptions="flagNoFullscreen|actionDone"
            android:maxLength="5"
            android:textColor="@color/dark_background"
            android:textColorHint="#88000000"
            android:textSize="24sp"
            android:textStyle="bold" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvGoalPaceError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/accent_error"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- 선택된 목표 요약 -->
    <TextView
        android:id="@+id/tvGoalSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3.0 km · 6:00 /km 으로 달리기"
        android:textColor="@color/sea_blue_light"
        android:textSize="13sp"
        android:layout_marginBottom="20dp"
        android:visibility="invisible" />

    <!-- 확인 버튼 -->
    <Button
        android:id="@+id/btnGoalConfirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="@color/sea_blue"
        android:text="목표 설정 완료"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        style="@style/Widget.MaterialComponents.Button" />

</LinearLayout>
